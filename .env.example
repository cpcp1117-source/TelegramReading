APP_DATABASE_PORT=5432
APP_DATABASE_NAME=telegram_trader
APP_DATABASE_USER=postgres
APP_DATABASE_PASSWORD=
POSTGRES_PASSWORD=
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=offline-foundation
APP_HTTP_HOST=0.0.0.0
APP_HTTP_PORT=8080
TELEGRAM_API_ID=
