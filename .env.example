BINANCE_API_BASE_URL=https://fapi.binance.com
BINANCE_SNAPSHOT_MAX_AGE_SECONDS=21600
# Phase 6 Slice 2 (Execution Gateway) only -- Testnet-only key, never Production.
# Per docs/phase-0/credential-handoff.md §5: mount only into the Execution Gateway,
# never fall back to a Production endpoint or credential.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://demo-fapi.binance.com
BINANCE_TESTNET_WS_BASE_URL=wss://demo-fstream.binance.com
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_REQUEST_TIMEOUT_SECONDS=30
THESIS_MODEL=gpt-4o-mini
THESIS_BATCH_SIZE=25
RISK_LEVERAGE=5
RISK_DEFAULT_STOP_ROE_PCT=0.30
RISK_POSITION_SIZE_PCT=0.20
RISK_MAX_CONCURRENT_POSITIONS=3
RISK_DAILY_LOSS_KILL_SWITCH_PCT=0.06
RISK_MAX_RECEIVE_LAG_SECONDS=10
RISK_MAX_PRICE_DEVIATION_BPS=50
RISK_EQUITY_BASELINE_USDT=
